# Токен бота Telegram (получить у @BotFather)
TG_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# Telegram ID владельца (для логов и дублирования важных сообщений)
OWNER_TG_ID="123456789"

# Путь к файлу базы данных SQLite
DB_PATH="database.db"

# User-Agent для сетевых запросов
USER_AGENT="Mozilla/5.0 ..."

# Связка чатов {"ID_ЧАТА_MAX": ID_ГРУППЫ_TELEGRAM}
# Важно: ID чатов Telegram должны быть целыми числами (для супергрупп обычно начинаются с -100...)
MAX_TG_PAIRS='{"-1234123412341234": -1001234567890}'

# Payload аутентификации устройства (из DevTools браузера при входе в Max Web)
MAX_DEVICE_AUTH_PAYLOAD='{"deviceId": "your-device-id", "appVersion": "web/1.0"}'

# Payload токена авторизации (из DevTools браузера при входе в Max Web)
MAX_TOKEN_PAYLOAD='{"token": "your-auth-token"}'
